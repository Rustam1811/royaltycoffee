# Firebase Admin (любой вариант)
# FIREBASE_KEY_BASE64=...
# или
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Админ-номера (через запятую, E.164)
ADMIN_PHONES=+77010000001

# OTP / WhatsApp
WHATSAPP_MODE=MOCK
# для CLOUD_API:
# WA_PHONE_NUMBER_ID=...
# WA_ACCESS_TOKEN=...

# OTP / SMS (production preferred)
# В проде используем SMSPM, в деве код возвращается в ответе и отправляется мок-каналом
SMSPM_ENDPOINT=https://smspm.com/api/message/sms
SMSPM_TOKEN=
SMSPM_HASH=
SMSPM_FROM=smspm.com

# Дополнительно
OTP_TTL_SEC=300
MOCK_OTP=1
PORT=3001
CORS_ORIGIN=http://localhost:5173
