// Firestore Security Rules
// Copy this to Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.admin == true || 
              request.auth.token.owner == true ||
              request.auth.token.role == 'admin' ||
              request.auth.token.role == 'owner' ||
              request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com', 'owner121@gmail.com']);
    }
    
    function isBarista() {
      return isAuthenticated() && 
             (request.auth.token.barista == true ||
              request.auth.token.role == 'barista' ||
              request.auth.token.email in ['barista121@gmail.com']);
    }
    
    function isStaff() {
      return isAdmin() || isBarista();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Stories collection - public read, admin write only
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders collection - admin and barista full access, users can read their own
    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isStaff();
      
      // Status history subcollection
      match /statusHistory/{historyId} {
        allow read: if isStaff() || (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        allow write: if isStaff();
      }
    }
    
    // Users collection - admin access + user can manage own data
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      
      // Allow user to create their own document with required fields
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAny(['phone', 'email', 'name']);
      
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['phone', 'name', 'email', 'avatar', 'updatedAt', 'pushOptIn', 'marketingOptIn', 'subscribePromotions', 'subscribeStories', 'lastOrderAt', 'fcmToken', 'notificationsEnabled', 'lastTokenUpdate']);
      
      // User FCM tokens subcollection
      match /tokens/{tokenId} {
        allow read, write, delete: if isOwner(userId);
      }
      
      // Notifications suppress settings
      match /notifications_suppress/{type} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Categories collection - admin write, public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Promotions collection - admin write, public read
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // News collection - admin write, public read
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bonus settings - admin write, public read
    match /settings/bonus {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Notifications log - admin read, functions write
    match /notifications_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
