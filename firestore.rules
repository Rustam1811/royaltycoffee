// Firestore Security Rules
// Copy this to Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stories collection - public read, admin write
    match /stories/{storyId} {
      // Allow public read for all stories
      allow read: if true;
      
      // Allow write only for authenticated admin users
      // For now, allow all writes (dev mode)
      allow write: if true;
      
      // For production, uncomment and use custom claims:
      // allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Orders collection - admin access only
    match /orders/{orderId} {
      // Allow read/write for authenticated admin users
      // For dev mode, allow for specific emails
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // Users collection - admin access only
    match /users/{userId} {
      // Allow read/write for authenticated admin users
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // Categories collection - admin write, public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // Promotions collection - admin write, public read
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // All other collections - deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
