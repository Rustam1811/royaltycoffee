# Android Keystore config for release signing
# Generate keystore: keytool -genkeypair -v -storetype PKCS12 -keystore royalty-coffee.keystore -alias royalty-coffee -keyalg RSA -keysize 2048 -validity 10000
# Then fill in values below and place keystore file in android/ directory.

storeFile=royalty-coffee.keystore
storePassword=REPLACE_ME
keyAlias=royalty-coffee
keyPassword=REPLACE_ME
