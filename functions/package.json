{
  "name": "functions",
  "scripts": {
    "lint": "echo 'lint skipped'",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase emulators:start --only functions",
    "shell": "npm run build && npx firebase functions:shell",
    "start": "npm run shell",
    "deploy:functions": "npm run build && npx firebase deploy --only functions",
    "deploy": "npm run build && npx firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "tough-cookie": "^4.1.4",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^13.0.0",
    "typescript": "^5.5.4"
  },
  "private": true
}
