{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "lib":  [
                                        "DOM",
                                        "DOM.Iterable",
                                        "ES2020"
                                    ],
                            "module":  "ESNext",
                            "moduleResolution":  "Node",
                            "strict":  true,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "allowSyntheticDefaultImports":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "baseUrl":  "./src",
                            "paths":  {
                                          "@/*":  [
                                                      "*"
                                                  ]
                                      },
                            "types":  [
                                          "vite/client",
                                          "node"
                                      ],
                            "composite":  true,
                            "declaration":  true,
                            "emitDeclarationOnly":  true,
                            "outDir":  "./.types"
                        },
    "include":  [
                    "src"
                ]
}
