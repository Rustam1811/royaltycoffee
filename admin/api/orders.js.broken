module.exports = async (req, res) => {        }

  // CORS headers      ],

  res.setHeader('Access-Control-Allow-Origin', '*');      admin: true 

  res.setHeader('Access-Control-Allow-Methods', 'GET,POST,PUT,DELETE,OPTIONS');    });

  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');  }

    

  if (req.method === 'OPTIONS') {  return res.status(400).json({ ok: false, error: 'Invalid action. Use ?action=get' });

    return res.status(204).end();};

  }
  
  const action = req.query?.action || '';
  const path = req.url?.split('?')[0] || '';
  
  // POST /api/orders или /api/placeOrder - создать заказ
  if (req.method === 'POST' && (path.includes('/orders') || path.includes('/placeOrder'))) {
    try {
      const orderData = req.body;
      
      if (!orderData || !orderData.items || orderData.items.length === 0) {
        return res.status(400).json({ 
          ok: false, 
          error: 'Invalid order data. Items are required.' 
        });
      }
      
      // Генерация номера заказа
      const orderNumber = `${Date.now().toString().slice(-8)}`;
      
      // Подготовка данных для Firestore
      const firestoreOrder = {
        userId: orderData.userId || 'guest',
        orderNumber: orderNumber,
        orderNumberDisplay: `#${orderNumber.slice(-4)}`,
        customerName: orderData.customerName || 'Клиент',
        customerPhone: orderData.customerPhone || '',
        
        // ВАЖНО: поля для фильтрации в админке
        type: orderData.deliveryType || 'pickup', // 'delivery' или 'pickup'
        deliveryType: orderData.deliveryType || 'pickup',
        status: 'NEW', // NEW -> ACCEPTED -> PREPARING -> READY -> COMPLETED
        
        // Адрес доставки (если есть)
        ...(orderData.deliveryInfo?.address && {
          address: orderData.deliveryInfo.address,
          deliveryAddress: orderData.deliveryInfo.address.street || '',
        }),
        
        // Состав заказа
        items: orderData.items.map(item => ({
          id: item.id,
          name: item.name,
          price: item.price || 0,
          quantity: item.quantity || 1,
          sizeKey: item.sizeKey,
          milkKey: item.milkKey,
          syrupKey: item.syrupKey,
        })),
        
        // Суммы
        total: orderData.amount || 0,
        amount: orderData.amount || 0,
        bonusToUse: orderData.bonusToUse || 0,
        deliveryFee: orderData.deliveryInfo?.fee?.total || 0,
        
        // Временные метки
        createdAt: admin.firestore.FieldValue.serverTimestamp(),
        updatedAt: admin.firestore.FieldValue.serverTimestamp(),
        
        // Метаданные
        clientRequestId: orderData.clientRequestId,
        source: 'client-app',
      };
      
      // Сохранение в Firestore
      const docRef = await db.collection('orders').add(firestoreOrder);
      
      console.log(`✅ Order created: ${docRef.id}, type: ${firestoreOrder.type}, status: ${firestoreOrder.status}`);
      
      // Возврат успешного ответа
      return res.status(200).json({
        ok: true,
        message: `Заказ #${orderNumber} принят!`,
        order: {
          id: docRef.id,
          orderNumber: orderNumber,
          orderNumberDisplay: `#${orderNumber.slice(-4)}`,
          amount: orderData.amount || 0,
          status: 'NEW',
          type: firestoreOrder.type,
        },
        orderId: docRef.id,
      });
      
    } catch (error) {
      console.error('Error creating order:', error);
      return res.status(500).json({ 
        ok: false, 
        error: 'Failed to create order', 
        details: error.message 
      });
    }
  }
  
  // GET /api/orders?action=get - получить все заказы
  if (req.method === 'GET' && action === 'get') {
    try {
      const snapshot = await db.collection('orders')
        .orderBy('createdAt', 'desc')
        .limit(100)
        .get();
      
      const orders = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data(),
        createdAt: doc.data().createdAt?.toDate?.()?.toISOString() || new Date().toISOString(),
      }));
      
      return res.status(200).json({ 
        ok: true, 
        orders,
        count: orders.length,
      });
    } catch (error) {
      console.error('Error fetching orders:', error);
      return res.status(500).json({ 
        ok: false, 
        error: 'Failed to fetch orders',
        details: error.message,
      });
    }
  }
  
  // GET /api/orders?action=user&userId=XXX - заказы пользователя
  if (req.method === 'GET' && action === 'user') {
    const userId = req.query?.userId;
    
    if (!userId) {
      return res.status(400).json({ 
        ok: false, 
        error: 'userId is required' 
      });
    }
    
    try {
      const snapshot = await db.collection('orders')
        .where('userId', '==', userId)
        .orderBy('createdAt', 'desc')
        .limit(50)
        .get();
      
      const orders = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data(),
        createdAt: doc.data().createdAt?.toDate?.()?.toISOString() || new Date().toISOString(),
      }));
      
      return res.status(200).json({ 
        ok: true, 
        orders,
        count: orders.length,
      });
    } catch (error) {
      console.error('Error fetching user orders:', error);
      return res.status(500).json({ 
        ok: false, 
        error: 'Failed to fetch user orders',
        details: error.message,
      });
    }
  }
  
  return res.status(400).json({ 
    ok: false, 
    error: 'Invalid request. Use POST /api/orders to create or GET /api/orders?action=get' 
  });
};
