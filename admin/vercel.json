{
  "version": 2,
  "env": {
    "VITE_API_BASE": "/api"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://us-central1-royal-coffee-b1ce9.cloudfunctions.net/app/api/:path*"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
