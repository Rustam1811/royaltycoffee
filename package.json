{
    "name": "royal-coffee",
    "private": true,
    "version": "1.1.0",
    "scripts": {
        "dev": "npm run dev:web",
        "dev:web": "cross-env NODE_ENV=development vite",
        "dev:admin": "cross-env NODE_ENV=development vite --config admin/vite.config.ts",
        "dev:workshop": "cd workshop && npm run dev",
        "dev:landing": "cd public/landing && npm run dev",
        "dev:functions": "firebase emulators:start --only functions",
        "dev:api": "node api-server.cjs",
        "dev:local": "concurrently -n API,WEB,ADMIN -c cyan,magenta,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
        "dev:all": "concurrently -n API,WEB,ADMIN,WORKSHOP -c cyan,magenta,green,yellow \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\" \"npm run dev:workshop\"",
        "build": "npm run build:all",
        "typecheck": "tsc --noEmit",
        "export-admin": "cd admin && npm ci && npm run build",
        "export-landing": "cd public/landing && npm ci && npm run build",
        "deploy": "npm run build:all && firebase deploy --only hosting",
        "preview": "vite preview",
        "test.e2e": "cypress run",
        "test.unit": "vitest",
        "lint": "eslint",
        "build:web": "cross-env NODE_ENV=production vite build && npm run build:copy-public && npm run build:cleanup",
        "build:admin": "cd admin && npm run build",
        "build:workshop": "cd workshop && npm run build",
        "build:landing": "cd public/landing && npm run build",
        "build:all": "npm run build:web && npm run build:admin && npm run build:workshop && npm run build:landing && npm run build:cleanup",
        "build:copy-public": "node scripts/copy-public.mjs",
        "build:cleanup": "node scripts/cleanup-dist.mjs",
        "setup:roles": "node scripts/setup-roles.js",
        "preview:web": "vite preview --port 4173",
        "preview:admin": "vite preview --config admin/vite.config.ts --port 4174",
        "preview:landing": "cd public/landing && npm run preview",
        "cap:init:android": "npx cap add android",
        "cap:init:ios": "npx cap add ios",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "cap:open:ios": "npx cap open ios",
        "cap:build:android": "cross-env CAPACITOR_BUILD=true npm run build:all && node scripts/copy-workshop-to-app.mjs && npx cap sync android",
        "cap:build:ios": "cross-env CAPACITOR_BUILD=true npm run build:all && node scripts/copy-workshop-to-app.mjs && npx cap sync ios",
        "cap:run:android": "npx cap run android",
        "cap:run:ios": "npx cap run ios",
        "postinstall": "node scripts/patch-firebase-auth-spm.mjs"
    },
    "dependencies": {
        "@capacitor-firebase/authentication": "^7.5.0",
        "@capacitor/android": "^8.1.0",
        "@capacitor/app": "7.0.0",
        "@capacitor/cli": "^8.1.0",
        "@capacitor/core": "^8.1.0",
        "@capacitor/haptics": "7.0.0",
        "@capacitor/ios": "^8.1.0",
        "@capacitor/keyboard": "7.0.0",
        "@capacitor/push-notifications": "^8.0.1",
        "@capacitor/status-bar": "7.0.0",
        "@emailjs/browser": "^4.4.1",
        "@heroicons/react": "^2.2.0",
        "@react-three/drei": "^9.122.0",
        "@react-three/fiber": "^8.18.0",
        "@splidejs/react-splide": "^0.7.12",
        "@types/leaflet": "^1.9.21",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@types/recharts": "^1.8.29",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "firebase": "^11.5.0",
        "firebase-admin": "^13.3.0",
        "firebase-functions": "^6.4.0",
        "framer-motion": "^12.23.12",
        "i18next": "^25.8.1",
        "i18next-http-backend": "^3.0.2",
        "jsonwebtoken": "^9.0.2",
        "konva": "^9.3.22",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.515.0",
        "mercadopago": "^2.11.0",
        "nanoid": "^5.1.5",
        "qrcode.react": "^4.2.0",
        "react": "^18.2.0",
        "react-countup": "^6.5.3",
        "react-dom": "^18.2.0",
        "react-i18next": "^15.5.3",
        "react-insta-stories": "^2.8.0",
        "react-konva": "^18.2.10",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "react-swipeable": "^7.0.2",
        "recharts": "^2.15.4",
        "split.js": "^1.6.5",
        "tailwind-scrollbar-hide": "^4.0.0"
    },
    "engines": {
        "node": "20.x"
    },
    "devDependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "@tailwindcss/postcss": "^4.1.5",
        "@testing-library/dom": ">=7.21.4",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/cors": "^2.8.17",
        "@types/jest": "^29.5.14",
        "@types/react": "^18.0.27",
        "@types/react-dom": "^18.0.10",
        "@types/three": "^0.174.0",
        "@vitejs/plugin-legacy": "^5.0.0",
        "@vitejs/plugin-react": "^4.4.1",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "cypress": "^13.5.0",
        "depcheck": "^1.4.7",
        "eslint": "^9.20.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "jsdom": "^22.1.0",
        "knip": "^5.63.0",
        "postcss": "^8.5.3",
        "qrcode-terminal": "^0.12.0",
        "react-icons": "^5.5.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.0.12",
        "terser": "^5.4.0",
        "three": "^0.176.0",
        "ts-prune": "^0.10.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.24.0",
        "vite": "^5.4.21",
        "vite-plugin-pwa": "^1.0.0",
        "vitest": "^0.34.6"
    },
    "description": "Royal Coffee — mobile-first loyalty & ordering app"
}
