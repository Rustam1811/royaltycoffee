    "scripts":  {
                    "dev":  "vercel dev",
                    "dev:api":  "node simple-api.js",
                    "dev:web":  "cross-env NODE_ENV=development vite",
                    "dev:admin":  "cross-env NODE_ENV=development vite --config admin/vite.config.ts",
                    "dev:all":  "concurrently -n API,WEB,ADMIN -c cyan,magenta,green \"vercel dev\" \"npm run dev:web\" \"npm run dev:admin\"",
                    "build":  "vite build",
                    "typecheck":  "tsc --noEmit",
                    "export-admin":  "cd admin \u0026\u0026 npm ci \u0026\u0026 npm run build \u0026\u0026 npm run export",
                    "deploy":  "npm run build \u0026\u0026 npm run export-admin \u0026\u0026 vercel deploy --prod",
                    "preview":  "vite preview",
                    "test.e2e":  "cypress run",
                    "test.unit":  "vitest",
                    "lint":  "eslint",
                    "build:web":  "vite build",
                    "build:admin":  "vite build --config admin/vite.config.ts",
                    "build:all":  "npm run build:web \u0026\u0026 npm run build:admin",
                    "preview:web":  "vite preview --port 4173",
                    "preview:admin":  "vite preview --config admin/vite.config.ts --port 4174",
                    "vercel-build":  "echo Skip build"
                },
