# Firebase Environment Variables for Web (Vite)
# Copy to .env.local and fill with your Firebase project values

# Note: Code uses VITE_FIREBASE_* prefix (see src/lib/firebase.ts)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Cloud Messaging (FCM) - Web Push VAPID Key
VITE_FIREBASE_VAPID_KEY=your-vapid-key-here

# Firebase Admin SDK для API endpoints (Vercel / Functions)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Copy this file to .env and fill in your Firebase project values
