# Firebase Environment Variables for Web (Vite)
# Copy to .env.local and fill with your Firebase project values

# Note: Code uses VITE_FIREBASE_* prefix (see src/lib/firebase.ts)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Cloud Messaging (FCM) - Web Push VAPID Key
VITE_FIREBASE_VAPID_KEY=your-vapid-key-here

# Firebase Admin SDK для API endpoints (Vercel)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Example (replace with your values):
# VITE_FIREBASE_API_KEY=AIzaSyDXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VITE_FIREBASE_AUTH_DOMAIN=coffeeaddict-c9d70.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=coffeeaddict-c9d70
# VITE_FIREBASE_STORAGE_BUCKET=coffeeaddict-c9d70.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
# VITE_FCM_VAPID_KEY=BG1234567890abcdefghijklmnopqrstuvwxyz...

# Firebase Admin Example:
# FIREBASE_PROJECT_ID=coffeeaddict-c9d70
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@coffeeaddict-c9d70.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
